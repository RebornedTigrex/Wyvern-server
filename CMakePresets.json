{
  "version": 5,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Windows MSVC)",
      "description": "Default configuration for Windows with MSVC",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "warnings": {
        "deprecated": true
      }
    },
    {
      "name": "windows-release-VS2026",
      "displayName": "Windows Release (VS 2026)",
      "description": "Release build for Windows with Visual Studio 2026",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug-VS2026",
      "displayName": "Windows Debug (VS 2026)",
      "description": "Debug build for Windows with Visual Studio 2026",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release-build",
      "configurePreset": "windows-release-VS2026",
      "inheritConfigureEnvironment": true,
      "jobs": 4
    },
    {
      "name": "windows-debug-build",
      "configurePreset": "windows-debug-VS2026",
      "inheritConfigureEnvironment": true,
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-release-test",
      "configurePreset": "windows-release-VS2026",
      "inheritConfigureEnvironment": true
    },
    {
      "name": "windows-debug-test",
      "configurePreset": "windows-debug-VS2026",
      "inheritConfigureEnvironment": true
    }
  ]
}
